# From Supabase project settings -> API. The anon key is safe for the browser;
# RLS (see supabase_schema.sql) restricts each user to their own rows.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Server-only (no NEXT_PUBLIC_ prefix — never sent to the browser). Used by
# app/api/draft-cover-letter to verify the caller's session before spending
# an API call, and to generate the draft itself.
SUPABASE_SERVICE_KEY=<service-role-key>
GROQ_API_KEY=<groq-key>  # free tier, no card required — console.groq.com
GROQ_API_KEY_FALLBACK=<second-groq-key>  # optional — used once the primary hits its 100k-tokens/day cap
